             set(_as /astral)
@@ -242,6 +242,8 @@
     endif()
 endforeach()
 
+string(APPEND _remap "${_rustflag_separator}--remap-path-prefix=${CMAKE_CURRENT_SOURCE_DIR}=/astral")
+
 if(ASTRAL_BUILD_TUI AND CARGO_EXECUTABLE)
