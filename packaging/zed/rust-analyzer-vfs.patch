+#[cfg(target_os = "wasi")]
+mod browser_vfs {
+    use super::*;
+
+    #[link(wasm_import_module = "__wasip1_vfs-host")]
+    unsafe extern "C" {
+        fn zed_vfs_snapshot(
+            list: u32,
+            path: *const u8,
+            path_len: usize,
+            output: *mut u8,
+            capacity: usize,
+        ) -> i32;
+    }
+
+    fn snapshot(list: bool, path: &AbsPath) -> Option<Vec<u8>> {
+        let path = path.as_str().as_bytes();
+        for _ in 0..2 {
+            let len = unsafe {
+                zed_vfs_snapshot(list as u32, path.as_ptr(), path.len(), std::ptr::null_mut(), 0)
+            };
+            if !(0..=8 * 1024 * 1024).contains(&len) {
+                return None;
+            }
+            let mut bytes = vec![0; len as usize];
+            if bytes.is_empty() {
+                return Some(bytes);
+            }
+            let written = unsafe {
+                zed_vfs_snapshot(
+                    list as u32,
+                    path.as_ptr(),
+                    path.len(),
+                    bytes.as_mut_ptr(),
+                    bytes.len(),
+                )
+            };
+            if (0..=len).contains(&written) {
+                bytes.truncate(written as usize);
+                return Some(bytes);
+            }
+        }
+        None
+    }
+
+    pub(super) fn read(path: &AbsPath) -> Option<Vec<u8>> {
+        snapshot(false, path)
+    }
+
+    pub(super) fn list(root: &AbsPath) -> Vec<AbsPathBuf> {
+        let Some(paths) = snapshot(true, root) else { return Vec::new() };
+        let Ok(paths) = String::from_utf8(paths) else { return Vec::new() };
+        paths
+            .split_terminator('\0')
+            .filter_map(|path| AbsPathBuf::try_from(Utf8PathBuf::from(path)).ok())
+            .collect()
+    }
+}
