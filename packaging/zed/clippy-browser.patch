+fn config_search_path(path: PathBuf) -> io::Result<PathBuf> {
+    // The browser's project snapshot has no symlinks. WASI's Rust standard
+    // library does not implement canonicalize, but metadata and open work.
+    if cfg!(target_os = "wasi") {
+        std::path::absolute(path)
+    } else {
+        path.canonicalize()
